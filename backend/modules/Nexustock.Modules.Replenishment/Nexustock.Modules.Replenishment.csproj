<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexustock.Modules.Inventory\Nexustock.Modules.Inventory.csproj" />
    <ProjectReference Include="..\Nexustock.Modules.MasterData\Nexustock.Modules.MasterData.csproj" />
    <ProjectReference Include="..\Nexustock.Modules.Rules\Nexustock.Modules.Rules.csproj" />
    <ProjectReference Include="..\Nexustock.Modules.Identity\Nexustock.Modules.Identity.csproj" />
    <ProjectReference Include="..\Nexustock.Modules.Inbound\Nexustock.Modules.Inbound.csproj" />
    <ProjectReference Include="..\Nexustock.Modules.Exceptions\Nexustock.Modules.Exceptions.csproj" />
    <ProjectReference Include="..\Nexustock.Modules.Qc.Abstractions\Nexustock.Modules.Qc.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.21">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.9" />
  </ItemGroup>

</Project>
